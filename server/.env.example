PORT=5000
NODE_ENV=development

MONGODB_URI=

JWT_SECRET=
# Sessions slide forward on use — /auth/me re-issues a token once the current
# one is over 7 days old, so an active customer is never signed out.
JWT_EXPIRES_IN=30d

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# Every link in every customer email is built from this — welcome, order
# delivery, and password reset. On a deployed environment it MUST be the public
# site address (e.g. https://www.rswebsoft.in). Left as localhost, the emails
# still send and still look right, but every link points at the recipient's own
# machine and password reset stops working entirely.
CLIENT_URL=http://localhost:5173

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_NOTIFY_EMAIL=
